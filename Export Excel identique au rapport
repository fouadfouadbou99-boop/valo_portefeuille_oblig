def export_excel(
    report_df,
    metrics_df,
    filename="portfolio_analysis_report.xlsx"
):

    with pd.ExcelWriter(
        filename,
        engine="xlsxwriter"
    ) as writer:

        report_df.to_excel(
            writer,
            sheet_name="Portfolio_Analysis",
            index=False
        )

        metrics_df.to_excel(
            writer,
            sheet_name="Aggregated_Metrics",
            index=False
        )

    return filename
