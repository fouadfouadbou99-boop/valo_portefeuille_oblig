def calculate_convexity(row):

    settlement = pd.to_datetime(
        row["Date Règlement"]
    )

    rate = row["Taux_Interpole"]

    dirty_price = row["Dirty_Price"]

    if dirty_price == 0:
        return 0

    total = 0

    for cf in row["Cash_Flows"]:

        t = (
            cf["Date"] - settlement
        ).days / 365.25

        if t > 0:

            pv = (
                cf["Amount"]
                / ((1 + rate) ** t)
            )

            total += (
                t * (t + 1)
                * pv
            )

    convexity = (
        total
        / (
            dirty_price
            * ((1 + rate) ** 2)
        )
    )

    return convexity
